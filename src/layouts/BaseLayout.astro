---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import SeoHead from '../components/SeoHead.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1114" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SeoHead title={title} description={description} ogImage={ogImage} />
    <LocalBusinessJsonLd />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsAppBar />
    <script>
      import { initTabs } from '../lib/tabs';
      import { trackClicks } from '../lib/track';
      trackClicks();
      initTabs();

      // Stagger the parts of each block as it enters.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(({ isIntersecting, target }) => {
          if (!isIntersecting) return;
          target.classList.add('is-in');
          observer.unobserve(target);
        });
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((block) => {
        [...block.children].forEach((child, index) => (child as HTMLElement).style.setProperty('--i', String(index)));
        if (reduced) block.classList.add('is-in');
        else observer.observe(block);
      });

    </script>
  </body>
</html>
