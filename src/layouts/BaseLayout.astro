---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LocalBusinessJsonLd from '../components/LocalBusinessJsonLd.astro';
import SeoHead from '../components/SeoHead.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1114" />
    <SeoHead title={title} description={description} ogImage={ogImage} />
    <LocalBusinessJsonLd />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
    <WhatsAppBar />
    <script>
      import { trackClicks } from '../lib/track';
      trackClicks();
    </script>
  </body>
</html>
