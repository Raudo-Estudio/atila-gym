---
import { NAV, SITE } from '../data/site';
---
<footer class="footer">
  <div>
    <p class="footer__name">{SITE.name}</p>
    <address>
      {SITE.streetAddress}<br />
      {SITE.addressDetail}<br />
      {SITE.locality}, Tigre
    </address>
  </div>
  <div>
    <p>Lunes a viernes de 7 a 23 h</p>
    <p>Sábados de 10 a 20 h</p>
    <p>Domingos cerrado</p>
  </div>
  <ul>
    {NAV.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
    <li><a href={SITE.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
    <li><a href={`tel:${SITE.phone.replaceAll(/[\s-]/g, '')}`}>{SITE.phoneDisplay}</a></li>
  </ul>
</footer>

<style>
  .footer {
    display: grid;
    gap: 2.5rem;
    padding: 4rem var(--margin) 6rem;
    background: var(--plancha);
    color: var(--metal);
  }
  .footer__name {
    margin-bottom: 0.5rem;
    color: var(--blanco);
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 800;
    text-transform: uppercase;
  }
  address { font-style: normal; }
  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  a:hover { color: var(--blanco); }
  @media (min-width: 48rem) {
    .footer { grid-template-columns: 2fr 2fr 1fr; padding-bottom: 4rem; }
  }
</style>
