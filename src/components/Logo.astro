---
interface Props {
  class?: string;
  /** Shows "ATILA GYM" under the mark. */
  withName?: boolean;
}
const { class: className, withName = true } = Astro.props;
// shortcut: redrawn from the client's logo image; swap for their original vector when it arrives.
---
<svg
  class:list={['logo', className]}
  viewBox={withName ? '0 0 200 140' : '0 0 200 104'}
  role="img"
  aria-label="Atila Gym"
  fill="currentColor"
>
  <path fill-rule="evenodd" d="M84 6h26l36 92h-13L100 32 74 98H52z" />
  <rect x="10" y="55" width="180" height="10" />
  <rect x="24" y="36" width="13" height="48" rx="2" />
  <rect x="13" y="44" width="11" height="32" rx="2" />
  <rect x="4" y="54" width="9" height="12" rx="1.5" />
  <rect x="163" y="36" width="13" height="48" rx="2" />
  <rect x="176" y="44" width="11" height="32" rx="2" />
  <rect x="187" y="54" width="9" height="12" rx="1.5" />
  {withName && (
    <text
      x="100"
      y="132"
      text-anchor="middle"
      font-family="'Barlow Condensed', 'Arial Narrow', sans-serif"
      font-size="30"
      font-weight="800"
      letter-spacing="1.5"
    >ATILA GYM</text>
  )}
</svg>

<style>
  .logo { display: block; height: auto; }
</style>
