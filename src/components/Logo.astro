---
interface Props {
  class?: string;
  /** Shows "ATILA GYM" under the mark. */
  withName?: boolean;
}
const { class: className, withName = true } = Astro.props;
// Traced on a 448 px grid from the client's logo image; swap for their vector file when it arrives.
---
<svg
  class:list={['logo', className]}
  viewBox={withName ? '0 80 448 290' : '0 80 448 228'}
  role="img"
  aria-label="Atila Gym"
  fill="currentColor"
>
  <!-- Part classes let a page animate the mark piece by piece; --i orders the plates from the bar outward. -->
  <rect class="logo__plate" style="--i: 2" x="5" y="196" width="24" height="46" />
  <rect class="logo__plate" style="--i: 1" x="36" y="180" width="28" height="78" />
  <rect class="logo__plate" style="--i: 0" x="70" y="163" width="32" height="112" />
  <rect class="logo__plate" style="--i: 0" x="346" y="163" width="32" height="112" />
  <rect class="logo__plate" style="--i: 1" x="384" y="180" width="28" height="78" />
  <rect class="logo__plate" style="--i: 2" x="419" y="196" width="24" height="46" />
  <rect class="logo__bar" x="102" y="205" width="244" height="30" />
  <path class="logo__a" d="M186 88H262L332 300H286L230 130L176 300H118Z" />
  {withName && (
    <text
      x="224"
      y="360"
      text-anchor="middle"
      textLength="242"
      lengthAdjust="spacingAndGlyphs"
      font-family="'Barlow Condensed', 'Arial Narrow', sans-serif"
      font-size="58"
      font-weight="700"
    >ATILA GYM</text>
  )}
</svg>

<style>
  .logo { display: block; height: auto; }
</style>
