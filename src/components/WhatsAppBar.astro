---
import { SITE } from '../data/site';
---
<a class="whatsapp-fab" href={SITE.whatsappUrl} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.3A9.5 9.5 0 1 0 12 2.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    <path d="M8.6 7.4c.3-.5.6-.6 1-.6h.6c.2 0 .4.1.5.4l.8 1.9c.1.2 0 .4-.1.6l-.6.7c-.1.2-.1.4 0 .5.8 1.4 1.9 2.4 3.3 3.1.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.9.9c.2.1.3.3.3.5v.6c0 .4-.2.8-.6 1-.6.3-1.4.5-2.3.3-3-.7-5.6-3.3-6.3-6.3-.2-.8 0-1.6.2-2z" fill="currentColor" />
  </svg>
  <span class="whatsapp-fab__label">Escribinos</span>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.5rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--rojo);
    color: var(--blanco);
    font-weight: 500;
    text-decoration: none;
    /* It truly floats over the page, so it gets the one shadow. */
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
    transition: transform 200ms var(--ease-out), background-color 160ms;
  }
  .whatsapp-fab:hover { transform: translateY(-2px); background: #e0262f; }
  .whatsapp-fab:active { transform: scale(0.96); }
  .whatsapp-fab svg { width: 1.6rem; height: 1.6rem; flex: none; }
  .whatsapp-fab__label { display: none; }
  .js .whatsapp-fab { animation: fab-in 500ms var(--ease-out) 900ms backwards; }
  @keyframes fab-in { from { opacity: 0; transform: translateY(1rem) scale(0.9); } }
  @media (min-width: 48rem) {
    .whatsapp-fab { padding-right: 1.25rem; }
    .whatsapp-fab__label { display: inline; }
  }
</style>
