---
import { SITE } from '../data/site';
---
<a class="whatsapp-bar" href={SITE.whatsappUrl} target="_blank" rel="noopener">Escribinos por WhatsApp</a>

<style>
  .whatsapp-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 3.5rem;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--rojo);
    color: var(--blanco);
    font-weight: 500;
    text-decoration: none;
  }
  @media (min-width: 48rem) {
    .whatsapp-bar { display: none; }
  }
</style>
