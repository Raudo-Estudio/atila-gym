---
import PhotoSlot from '../PhotoSlot.astro';
import Section from '../Section.astro';
---
<Section id="app" tone="brasa">
  <div class="split">
    <div>
      <h2>App de rutinas incluida</h2>
      <p class="lead">Atila Coach arma tu rutina según tu objetivo y la ajusta cada 6 semanas según tu rendimiento.</p>
      <ul class="coach__list">
        <li>Rutina personalizada con IA</li>
        <li>Progreso en pesos y ejercicios</li>
        <li>Tiempo y nivel de cada entrenamiento</li>
        <li>Bloques cortos para los días con poco tiempo</li>
        <li>Recetas según tus preferencias</li>
      </ul>
    </div>
    <PhotoSlot label="Captura de la app Atila Coach" ratio="4 / 5" />
  </div>
</Section>

<style>
  .coach__list { display: grid; gap: 0.5rem; margin: 0; padding-left: 1.1rem; }
</style>
