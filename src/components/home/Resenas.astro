---
import { REVIEWS } from '../../data/reviews';
import { SITE } from '../../data/site';
import Button from '../Button.astro';

const facts = [`${SITE.rating.value} en Google`, `${SITE.rating.count} reseñas`, '4 pisos', 'De 7 a 23 h'];
---
<section id="resenas" class="resenas">
  <div class="resenas__band" aria-hidden="true">
    <div class="resenas__track">
      {[0, 1].map(() => (
        <p>{facts.map((item) => <span>{item}</span>)}</p>
      ))}
    </div>
  </div>

  <div class="resenas__body">
    <div class="resenas__head" data-reveal>
      <h2>Lo que dicen los socios</h2>
      <p class="lead">{SITE.rating.value} sobre 5 en {SITE.rating.count} reseñas de Google.</p>
      <div class="resenas__controls">
        <button type="button" class="arrow" data-slide="-1" aria-label="Reseña anterior">‹</button>
        <button type="button" class="arrow" data-slide="1" aria-label="Reseña siguiente">›</button>
        <Button href={SITE.googleReviewsUrl} variant="quiet" external>Ver todas en Google</Button>
      </div>
    </div>

    <ul class="slider" data-slider tabindex="0" aria-label="Reseñas de socios en Google">
      {REVIEWS.map(({ author, text }) => (
        <li class="slide">
          <blockquote>{text}</blockquote>
          <p class="slide__author">{author}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  document.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!slider) return;
      const step = (slider.firstElementChild as HTMLElement).offsetWidth + 16;
      slider.scrollBy({ left: Number(button.dataset.slide) * step, behavior: 'smooth' });
    });
  });
</script>

<style>
  .resenas__band {
    display: flex;
    align-items: center;
    min-height: 22svh;
    overflow: hidden;
    background: var(--blanco);
    color: var(--carbon);
  }
  .resenas__track { display: flex; width: max-content; animation: run 40s linear infinite; }
  .resenas__track p {
    display: flex;
    max-width: none;
    font-family: var(--font-display);
    font-size: var(--step-display);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .resenas__track span::after {
    content: '';
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin: 0 0.35em 0.12em;
    border-radius: 50%;
    background: var(--rojo);
    vertical-align: middle;
  }

  .resenas__body { display: grid; gap: 3rem; padding: var(--section-space) var(--margin); }
  .resenas__head { display: grid; gap: 1.25rem; align-content: start; }
  .resenas__controls { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.5rem; }
  .arrow {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--plancha);
    color: var(--blanco);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms, transform 160ms var(--ease-out);
  }
  .arrow:hover { background: var(--rojo); }
  .arrow:active { transform: scale(0.92); }
  .resenas__controls :global(.button) { margin-left: 0.75rem; }

  .slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: 1rem;
    margin: 0 calc(-1 * var(--margin));
    padding: 0 var(--margin) 1rem;
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margin);
    scrollbar-width: none;
  }
  .slider::-webkit-scrollbar { display: none; }
  .slide {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1.5rem;
    min-height: 20rem;
    padding: 2rem;
    background: var(--plancha);
    scroll-snap-align: start;
  }
  .slide:nth-child(3n + 1) { background: var(--rojo); }
  blockquote { margin: 0; font-size: var(--step-lead); line-height: 1.25; }
  .slide__author { font-weight: 500; }

  @keyframes run { to { transform: translateX(-50%); } }
  @media (min-width: 60rem) {
    .resenas__band { min-height: 34svh; }
    .resenas__body { grid-template-columns: 4fr 8fr; align-items: start; gap: 4rem; }
    .slider { grid-auto-columns: calc((100% - 1rem) / 2); margin: 0 calc(-1 * var(--margin)) 0 0; padding-left: 0; scroll-padding-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .resenas__track { animation: none; }
  }
</style>
