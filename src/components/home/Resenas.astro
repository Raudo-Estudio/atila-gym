---
import { REVIEWS } from '../../data/reviews';
import { SITE } from '../../data/site';
import Button from '../Button.astro';
---
<section id="resenas" class="resenas">
  <div class="resenas__head" data-reveal>
    <h2>Lo que dicen los socios</h2>
    <p>{SITE.rating.value} sobre 5 en {SITE.rating.count} reseñas de Google.</p>
    <Button href={SITE.googleReviewsUrl} variant="quiet" external>Ver todas en Google</Button>
  </div>

  <div
    class="carousel"
    data-carousel
    tabindex="0"
    role="region"
    aria-label="Reseñas de socios en Google. Usá las flechas para moverte."
  >
    <ul class="carousel__track" data-track>
      {REVIEWS.map(({ author, text }) => (
        <li class="review">
          <blockquote>{text}</blockquote>
          <p class="review__author">{author}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const viewport = document.querySelector<HTMLElement>('[data-carousel]');
  const track = viewport?.querySelector<HTMLElement>('[data-track]');

  if (viewport && track) {
    // Copies of the cards make the loop seamless; they are hidden from assistive tech.
    const originals = [...track.children] as HTMLElement[];
    const addCopy = () =>
      originals.forEach((card) => {
        const copy = card.cloneNode(true) as HTMLElement;
        copy.setAttribute('aria-hidden', 'true');
        copy.inert = true;
        track.append(copy);
      });
    viewport.classList.add('is-live');
    addCopy();
    // One loop is the distance from a card to its first copy.
    const measure = () => (track.children[originals.length] as HTMLElement).offsetLeft - originals[0].offsetLeft;
    while (track.scrollWidth < measure() + viewport.clientWidth) addCopy();

    const speed = 40; // px per second
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let offset = 0;
    let loop = measure();
    let hovering = false;
    let focused = false;
    let drag: { x: number; offset: number } | null = null;
    let last = performance.now();

    const wrap = (value: number) => ((value % loop) + loop) % loop;
    const paint = () => (track.style.transform = `translate3d(${-offset}px, 0, 0)`);

    const tick = (now: number) => {
      const seconds = Math.min((now - last) / 1000, 0.1);
      last = now;
      if (!reduced && !hovering && !focused && !drag) {
        offset = wrap(offset + speed * seconds);
        paint();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    new ResizeObserver(() => {
      loop = measure();
      offset = wrap(offset);
      paint();
    }).observe(track);

    // Hover stops it where it is; leaving resumes from that same spot.
    viewport.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') hovering = true;
    });
    viewport.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') hovering = false;
    });

    viewport.addEventListener('pointerdown', (event) => {
      drag = { x: event.clientX, offset };
      viewport.setPointerCapture(event.pointerId);
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!drag) return;
      offset = wrap(drag.offset - (event.clientX - drag.x));
      paint();
    });
    const endDrag = () => {
      drag = null;
      viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    viewport.addEventListener('focus', () => (focused = true));
    viewport.addEventListener('blur', () => (focused = false));
    viewport.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = (track.firstElementChild as HTMLElement).offsetWidth;
      offset = wrap(offset + (event.key === 'ArrowRight' ? step : -step));
      paint();
    });
  }
</script>

<style>
  .resenas { padding-block: var(--section-space); background: var(--plancha); }
  .resenas__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
    margin-bottom: 2.5rem;
    padding-inline: var(--margin);
  }
  .resenas__head p { color: var(--metal); }
  .resenas__head :global(.button) { margin-left: auto; }

  /* Without the script it is a plain scrolling row. */
  .carousel { overflow-x: auto; padding-inline: var(--margin); }
  .carousel.is-live {
    overflow: hidden;
    padding-inline: 0;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  .carousel.is-dragging { cursor: grabbing; }
  .carousel:focus-visible { outline-offset: -3px; }
  .carousel__track { display: flex; gap: 1rem; width: max-content; margin: 0; padding: 0; list-style: none; }
  .is-live .carousel__track { will-change: transform; }

  .review {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1.5rem;
    width: min(80vw, 24rem);
    min-height: 13rem;
    padding: 1.75rem;
    background: var(--carbon);
  }
  blockquote { margin: 0; line-height: 1.5; }
  .review__author { color: var(--metal); font-size: var(--step-small); }
</style>
