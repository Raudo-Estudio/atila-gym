---
const facts = [
  { value: '4 pisos', label: 'Tres con máquinas por grupo muscular.' },
  { value: '7 a 23 h', label: 'De lunes a viernes. Sábados de 10 a 20 h.' },
  { value: '+10 años', label: 'Entrenando a la gente de Pacheco.' },
  { value: 'Sin reserva', label: 'Profes en sala para lo que necesites.' },
];
---
<section id="el-gym" class="about">
  <div class="about__photo blend" aria-hidden="true">
    <img src="/media/portada.webp" width="928" height="1152" alt="" loading="lazy" />
  </div>
  <div class="about__copy" data-reveal>
    <h2>El gym</h2>
    <p class="lead">Musculación en serio, con máquinas por grupo muscular y alguien que te guía en sala.</p>
  </div>
  <ul class="about__facts" data-reveal>
    {facts.map(({ value, label }) => (
      <li>
        <strong>{value}</strong>
        <span>{label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .about {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding: var(--section-space) var(--margin);
    overflow: hidden;
    isolation: isolate;
  }
  /* The room sits behind the content, like the PC behind "Tu puesto" on ArenaPro. */
  .about__photo {
    position: absolute;
    top: 0;
    right: 0;
    z-index: -1;
    width: min(90vw, 40rem);
    opacity: 0.55;
    pointer-events: none;
  }
  .about__photo img { display: block; width: 100%; height: auto; }
  .about__copy { display: grid; gap: 1rem; max-width: 34rem; }
  .about__copy .lead { color: var(--metal); }
  .about__facts {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(15 17 20 / 0.55);
  }
  .about__facts li {
    display: grid;
    gap: 0.35rem;
    padding: 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .about__facts li:last-child { border-bottom: 0; }
  .about__facts strong { font-family: var(--font-display); font-size: var(--step-title); font-weight: 800; line-height: 1; text-transform: uppercase; }
  .about__facts span { color: var(--metal); font-size: var(--step-small); }

  @media (min-width: 48rem) {
    .about__facts { grid-template-columns: 1fr 1fr; }
    .about__facts li { border-bottom: 1px solid rgb(255 255 255 / 0.08); }
    .about__facts li:nth-child(odd) { border-right: 1px solid rgb(255 255 255 / 0.08); }
    .about__facts li:nth-last-child(-n + 2) { border-bottom: 0; }
  }
  @media (min-width: 60rem) {
    .about__photo { right: 4%; width: 34rem; opacity: 0.7; }
    .about__facts li { padding: 2rem 2.5rem; }
  }
</style>
