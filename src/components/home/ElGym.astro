---
const facts = [
  { value: '4', label: 'pisos' },
  { value: '7 a 23 h', label: 'de lunes a viernes' },
  { value: '+10', label: 'años en Pacheco' },
  { value: 'Sin reserva', label: 'profes en sala' },
];
---
<section id="el-gym" class="about">
  <div class="about__copy" data-reveal>
    <h2>El gym</h2>
    <p class="lead">Musculación en serio, con máquinas por grupo muscular y alguien que te guía en sala.</p>
  </div>
  <ul class="about__facts" data-reveal>
    {facts.map(({ value, label }) => (
      <li>
        <strong>{value}</strong>
        <span>{label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .about { display: grid; gap: 2.5rem; padding: var(--section-space) var(--margin); }
  .about__copy { display: grid; gap: 1rem; }
  .about__copy .lead { max-width: 34ch; color: var(--metal); }
  .about__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; margin: 0; padding: 0; list-style: none; }
  .about__facts li { display: grid; gap: 0.25rem; padding-left: 1rem; border-left: 2px solid var(--rojo); }
  .about__facts strong { font-family: var(--font-display); font-size: var(--step-title); font-weight: 800; line-height: 1; text-transform: uppercase; }
  .about__facts span { color: var(--metal); font-size: var(--step-small); }
  @media (min-width: 60rem) {
    .about { grid-template-columns: 5fr 7fr; align-items: center; gap: 4rem; }
    .about__facts { grid-template-columns: repeat(4, 1fr); }
  }
</style>
