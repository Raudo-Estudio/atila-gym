---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import Section from '../Section.astro';

const items = [
  { title: 'Salones por grupo muscular', text: 'Cada espacio está equipado para lo que venís a trabajar, así entrenás sin perder tiempo.' },
  { title: 'Pesas, máquinas y cardio', text: 'Pesos libres, sala de musculación, funcional, cardio y elongación.' },
  { title: 'Profes en sala', text: 'Preguntá lo que necesites mientras entrenás. No hace falta reservar.' },
  { title: 'Vestuarios y duchas', text: 'Con aire acondicionado, calefacción, Wi-Fi y cafetería.' },
];
---
<Section id="el-gym">
  <div class="section-head">
    <h2>Gimnasio de musculación en Pacheco</h2>
    <div class="section-head__side">
      <p>Más que un lugar para entrenar: una comunidad que te acompaña y te impulsa todos los días.</p>
      <Button href={SITE.whatsappUrl} external>Vení a conocerlo</Button>
    </div>
  </div>
  <ul class="cards">
    {items.map(({ title, text }, index) => (
      <li class:list={['card', { 'card--rojo': index === 2 }]}>
        <h3>{title}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .cards { display: grid; gap: 1px; margin: 0; padding: 0; list-style: none; }
  .card { display: grid; align-content: start; gap: 1rem; padding: 2rem 1.5rem 2.5rem; background: var(--tarjeta); }
  .card h3 { font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2.1rem); font-weight: 800; line-height: 1; }
  .card p { color: var(--metal); }
  .card--rojo { background: var(--rojo); }
  .card--rojo p { color: var(--blanco); }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .cards { grid-template-columns: repeat(4, 1fr); } }
</style>
