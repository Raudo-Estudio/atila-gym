---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import Section from '../Section.astro';
---
<Section id="planes">
  <div class="split">
    <div>
      <h2>Cuotas y planes en Pacheco</h2>
      <p class="lead">Escribinos y te pasamos la cuota vigente y las formas de pago.</p>
    </div>
    <div class="planes__options">
      <div class="plan plan--rojo">
        <h3>Cuota del gym</h3>
        <p>Incluye salones, profes en sala y la app Atila Coach.</p>
        <Button href={SITE.whatsappUrl} external>Consultar la cuota</Button>
      </div>
      <div class="plan">
        <h3>Wellhub</h3>
        <p>Atila Gym Pacheco está disponible en Wellhub.</p>
        <Button href={SITE.wellhubUrl} variant="quiet" external>Ver en Wellhub</Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .planes__options { display: grid; gap: 1rem; }
  .plan { padding: 2rem 1.5rem; background: var(--tarjeta); }
  .plan p { margin-block: 0.5rem 1rem; color: var(--metal); }
  .plan--rojo { background: var(--rojo); }
  .plan--rojo p { color: var(--blanco); }
  .plan--rojo :global(.button--primary) { background: var(--carbon); }
</style>
