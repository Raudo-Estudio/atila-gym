---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
---
<section id="planes" class="planes">
  <h2 class="visually-hidden">Cuotas y planes</h2>
  <article class="plan plan--cuota" data-reveal>
    <h3>Cuota Atila</h3>
    <p class="plan__for">
      Para entrenar todos los días que quieras. Incluye los salones, los profes en sala y la app Atila Coach.
    </p>
    <div class="plan__foot">
      <p class="plan__price">Por WhatsApp</p>
      <Button href={SITE.whatsappUrl} variant="ink" external>Consultar la cuota</Button>
    </div>
  </article>
  <article class="plan plan--wellhub" data-reveal>
    <h3>Wellhub</h3>
    <p class="plan__for">Si tu empresa te da Wellhub, Atila Gym Pacheco está en la lista.</p>
    <div class="plan__foot">
      <p class="plan__price">Con tu plan</p>
      <Button href={SITE.wellhubUrl} external>Ver en Wellhub</Button>
    </div>
  </article>
</section>

<style>
  .planes { display: grid; }
  .plan {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 1.25rem;
    min-height: 70svh;
    padding: 2.5rem var(--margin);
  }
  .plan--cuota { background: var(--rojo); }
  .plan--wellhub { background: var(--plancha); }
  .plan h3 { font-size: var(--step-title); }
  .plan__for { max-width: 30ch; font-size: var(--step-body); }
  .plan__foot { display: grid; align-self: end; gap: 1.5rem; }
  .plan__price {
    font-family: var(--font-display);
    font-size: var(--step-title);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .plan__foot :global(.button) { width: 100%; }

  @media (min-width: 60rem) {
    .planes { grid-template-columns: 5fr 7fr; }
    .plan { min-height: 90svh; padding: 2.5rem; }
    .plan--cuota { grid-column: 2; grid-row: 1; padding-right: var(--margin); }
    .plan--wellhub { grid-column: 1; grid-row: 1; padding-left: var(--margin); }
    .plan--cuota .plan__price { font-size: var(--step-display); }
    .plan__foot { grid-template-columns: 1fr auto; align-items: end; }
    .plan__foot :global(.button) { width: auto; }
  }
</style>
