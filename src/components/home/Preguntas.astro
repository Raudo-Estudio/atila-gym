---
import { FAQ } from '../../data/faq';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<section id="preguntas" class="faq">
  <h2>Preguntas</h2>
  <div class="faq__list">
    {FAQ.map(({ q, a }) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq { display: grid; gap: 2rem; padding: var(--section-space) var(--margin); background: var(--carbon); }
  details { border-bottom: 1px solid var(--plancha); }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    flex: none;
    color: var(--rojo);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 200ms var(--ease-out);
  }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--metal); }
  details p { max-width: 52ch; padding-bottom: 1.25rem; color: var(--metal); }
  details[open] p { animation: panel-in 300ms var(--ease-out); }
  @media (min-width: 60rem) {
    .faq { grid-template-columns: 5fr 7fr; gap: 4rem; }
  }
</style>
