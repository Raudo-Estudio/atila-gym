---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import Photo from '../Photo.astro';

const rooms = [
  {
    id: 'pesos',
    tab: 'Pesos libres',
    title: 'Salón de pesos libres',
    text: 'Barras olímpicas, discos y mancuernas, con espacio para entrenar cómodo.',
    photo: 'salón de pesos libres',
  },
  {
    id: 'maquinas',
    tab: 'Máquinas',
    title: 'Sala de máquinas',
    text: 'Máquinas por grupo muscular en tres pisos, con remo y ski.',
    photo: 'sala de máquinas',
  },
  {
    id: 'vestuarios',
    tab: 'Vestuarios',
    title: 'Vestuarios y duchas',
    text: 'Con aire acondicionado y calefacción, para salir directo al trabajo.',
    photo: 'vestuarios con duchas',
  },
];
---
<section id="salones" class="salones" data-tabs>
  <div class="salones__head">
    <h2>Salones</h2>
    <div class="tabs" role="tablist" aria-label="Salones">
      {rooms.map(({ id, tab }) => (
        <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`}>{tab}</button>
      ))}
    </div>
  </div>
  {rooms.map(({ id, title, text, photo }) => (
    <div class="room" role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`}>
      <Photo alt={photo} ratio="16 / 9" />
      <div class="room__body">
        <h3>{title}</h3>
        <p>{text}</p>
        <Button href={SITE.instagramUrl} variant="quiet" external>Ver más en Instagram</Button>
      </div>
    </div>
  ))}
</section>

<style>
  .salones { padding: var(--section-space) var(--margin); background: var(--plancha); }
  .salones__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 1.75rem; }
  .salones__head .tabs { margin: 0; }
  .room { display: grid; gap: 1.5rem; }
  .room + .room { margin-top: 2rem; }
  .salones.is-tabbed .room + .room { margin-top: 0; }
  .room :global(.photo) { background: var(--carbon); }
  .room__body { display: grid; gap: 0.75rem; align-content: end; justify-items: start; }
  .room__body p { max-width: 36ch; color: var(--metal); }

  @media (min-width: 60rem) {
    .room { grid-template-columns: 8fr 4fr; align-items: end; gap: 2.5rem; }
  }
</style>
