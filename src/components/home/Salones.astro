---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import Photo from '../Photo.astro';

const rooms = [
  {
    title: 'Salón de pesos libres',
    text: 'Barras olímpicas, discos y mancuernas, con espacio para entrenar cómodo.',
    fact: 'Profes en sala, sin reserva',
    photo: 'salón de pesos libres',
  },
  {
    title: 'Sala de máquinas',
    text: 'Máquinas distribuidas por grupo muscular y bien mantenidas, en tres de los cuatro pisos.',
    fact: 'Remo y ski incluidos',
    photo: 'sala de máquinas',
  },
];
---
<section id="salones" class="salones">
  <div class="salones__head" data-reveal>
    <h2>Salones por grupo muscular</h2>
    <Button href={SITE.instagramUrl} variant="quiet" external>Ver el gym en Instagram</Button>
  </div>
  <div class="salones__list">
    {rooms.map(({ title, text, fact, photo }) => (
      <article class="room" data-reveal>
        <Photo alt={photo} ratio="3 / 2" />
        <h3>{title}</h3>
        <p>{text}</p>
        <p class="room__fact">{fact}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .salones { padding: var(--section-space) var(--margin); background: var(--plancha); }
  .salones__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 2.5rem; }
  .salones__list { display: grid; gap: 3rem; }
  .room { display: grid; gap: 0.75rem; align-content: start; }
  .room :global(.photo) { margin-bottom: 0.75rem; background: var(--carbon); }
  .room p { max-width: 44ch; color: var(--metal); }
  .room .room__fact { color: var(--blanco); font-weight: 500; }

  @media (min-width: 48rem) {
    .salones__list { grid-template-columns: 1fr 1fr; gap: 2rem; }
    /* Offset the second room so the pair does not read as a card row. */
    .room:nth-child(2) { margin-top: 5rem; }
  }
</style>
