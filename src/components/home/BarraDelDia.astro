---
import { HOURS, SITE } from '../../data/site';

const format = (time: string | null) => (time ? Number(time.split(':')[0]) : '');
const weekday = HOURS[1];
const saturday = HOURS[6];
const tel = `tel:${SITE.phone.replaceAll(/[\s-]/g, '')}`;
---
<section id="horarios" class="horarios">
  <div class="barra" data-reveal>
    <h2>Horarios y cómo llegar</h2>
    <p class="barra__status" data-barra-text>
      Lunes a viernes de {format(weekday.open)} a {format(weekday.close)} h, sábados de {format(saturday.open)} a
      {format(saturday.close)} h. Domingos cerrado.
    </p>
    <div class="barra__track" aria-hidden="true">
      <span class="barra__disc"></span>
      <span class="barra__bar"><span class="barra__now" data-barra-now hidden></span></span>
      <span class="barra__disc"></span>
    </div>
    <div class="barra__ends" aria-hidden="true">
      <span data-barra-start>{format(weekday.open)} h</span>
      <span data-barra-end>{format(weekday.close)} h</span>
    </div>
  </div>

  <address class="rows">
    <p class="row row--name">
      <span>{SITE.name}</span>
      <img src="/media/pacheco-calle.webp" width="1200" height="1600" alt="La Av. Hipólito Yrigoyen en Pacheco, con palmeras y carteles de calle" loading="lazy" />
    </p>
    <a class="row" href={SITE.directionsUrl} target="_blank" rel="noopener">{SITE.streetAddress}</a>
    <p class="row">{SITE.locality}, Tigre</p>
    <p class="row row--hours">
      <span>Lun a vie {format(weekday.open)}–{format(weekday.close)}</span>
      <span>Sáb {format(saturday.open)}–{format(saturday.close)}</span>
    </p>
    <a class="row" href={tel}>{SITE.phoneDisplay}</a>
    <a class="row row--hola" href={SITE.whatsappUrl} target="_blank" rel="noopener">
      <span>Hola</span>
      <span class="row__arrow" aria-hidden="true">→</span>
      <span class="visually-hidden">, escribinos por WhatsApp</span>
    </a>
  </address>
</section>

<script>
  import { getStatus } from '../../lib/hours';

  const status = getStatus(new Date());
  const hour = (time: string | null) => (time ? `${Number(time.split(':')[0])} h` : '');
  const text = document.querySelector('[data-barra-text]');
  const now = document.querySelector<HTMLElement>('[data-barra-now]');
  const start = document.querySelector('[data-barra-start]');
  const end = document.querySelector('[data-barra-end]');

  if (text) {
    text.textContent = status.open
      ? `Estamos abiertos hasta las ${status.closesAt}.`
      : `Ahora estamos cerrados. Abrimos el ${status.opensAt?.day} a las ${status.opensAt?.time}.`;
  }
  if (status.today.open) {
    if (start) start.textContent = hour(status.today.open);
    if (end) end.textContent = hour(status.today.close);
  }
  if (now && status.dayProgress !== null) {
    now.style.left = `${status.dayProgress * 100}%`;
    now.hidden = false;
  }
</script>

<style>
  .barra { padding: var(--section-space) var(--margin) 4rem; background: var(--rojo); }
  .barra__status { margin-block: 1.5rem 2.5rem; font-size: var(--step-lead); line-height: 1.25; }
  .barra__track { display: flex; align-items: center; height: clamp(4rem, 12vw, 9rem); }
  .barra__disc { flex: none; width: clamp(0.75rem, 2vw, 1.75rem); height: 100%; background: var(--carbon); }
  .barra__bar { position: relative; flex: 1; height: clamp(0.5rem, 1.2vw, 0.9rem); background: var(--blanco); }
  .barra__now {
    position: absolute;
    top: 50%;
    width: 0.5rem;
    height: clamp(3rem, 9vw, 6.5rem);
    background: var(--carbon);
    transform: translate(-50%, -50%);
  }
  .js .barra__now { animation: slide 1200ms var(--ease-out) 300ms backwards; }
  @keyframes slide { from { left: 0; } }
  .barra__ends {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 800;
  }

  .rows { display: grid; font-style: normal; }
  .row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.25rem;
    margin: 0;
    max-width: none;
    padding: 0.75rem var(--margin);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9.6vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }
  .row:nth-child(odd) { background: var(--carbon); }
  .row:nth-child(even) { background: var(--plancha); }
  a.row { transition: color 160ms, padding-left 300ms var(--ease-out); }
  a.row:hover { padding-left: calc(var(--margin) + 1rem); color: var(--rojo); }
  .row--name img {
    flex: none;
    align-self: center;
    width: clamp(4rem, 9vw, 8rem);
    height: clamp(4rem, 9vw, 8rem);
    border-radius: 50%;
    object-fit: cover;
  }
  .row--hours { flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 0.25rem; }
  .row--hola { justify-content: flex-start; background: var(--blanco) !important; color: var(--carbon); }
  .row--hola:hover { color: var(--rojo) !important; }
  .row__arrow {
    display: grid;
    place-items: center;
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    background: var(--rojo);
    color: var(--blanco);
    font-family: var(--font-body);
    font-size: 0.8em;
    transition: transform 200ms var(--ease-out);
  }
  .row--hola:hover .row__arrow { transform: translateX(0.2em); }

  @media (min-width: 60rem) {
    .row { min-height: 9.5rem; font-size: var(--step-title); }
    .row--hours { flex-direction: row; justify-content: flex-start; align-items: flex-end; gap: 0.6em; }
  }
</style>
