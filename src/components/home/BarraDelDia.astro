---
import { HOURS, SITE } from '../../data/site';
import Button from '../Button.astro';

const format = (time: string | null) => (time ? Number(time.split(':')[0]) : '');
const weekday = HOURS[1];
const saturday = HOURS[6];
---
<section id="horarios" class="horarios">
  <div class="horarios__info" data-reveal>
    <h2>Horarios y ubicación</h2>
    <p class="horarios__status" data-barra-text>Lunes a viernes de 7 a 23 h.</p>
    <div class="barra" aria-hidden="true">
      <div class="barra__track">
        <span class="barra__disc"></span>
        <span class="barra__bar"><span class="barra__now" data-barra-now hidden></span></span>
        <span class="barra__disc"></span>
      </div>
      <div class="barra__ends">
        <span data-barra-start>{format(weekday.open)} h</span>
        <span data-barra-end>{format(weekday.close)} h</span>
      </div>
    </div>
    <dl class="hours">
      <div><dt>Lun a vie</dt><dd>{format(weekday.open)} a {format(weekday.close)} h</dd></div>
      <div><dt>Sábados</dt><dd>{format(saturday.open)} a {format(saturday.close)} h</dd></div>
      <div><dt>Domingos</dt><dd>Cerrado</dd></div>
    </dl>
    <address>{SITE.streetAddress}, {SITE.locality}</address>
    <Button href={SITE.directionsUrl} variant="ghost" external>Cómo llegar</Button>
  </div>
  <iframe
    class="horarios__map"
    src={SITE.mapEmbedUrl}
    title="Mapa de Atila Gym en General Pacheco"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</section>

<script>
  import { getStatus } from '../../lib/hours';

  const status = getStatus(new Date());
  const hour = (time: string | null) => (time ? `${Number(time.split(':')[0])} h` : '');
  const text = document.querySelector('[data-barra-text]');
  const now = document.querySelector<HTMLElement>('[data-barra-now]');
  const start = document.querySelector('[data-barra-start]');
  const end = document.querySelector('[data-barra-end]');

  if (text) {
    text.textContent = status.open
      ? `Abierto ahora, hasta las ${status.closesAt}`
      : `Cerrado. Abre el ${status.opensAt?.day} a las ${status.opensAt?.time}`;
  }
  if (status.today.open) {
    if (start) start.textContent = hour(status.today.open);
    if (end) end.textContent = hour(status.today.close);
  }
  if (now && status.dayProgress !== null) {
    now.style.left = `${status.dayProgress * 100}%`;
    now.hidden = false;
  }
</script>

<style>
  .horarios { display: grid; gap: 2rem; padding: var(--section-space) var(--margin); background: var(--plancha); }
  .horarios__info { display: grid; gap: 1.25rem; align-content: start; justify-items: start; }
  .horarios__status { font-size: var(--step-lead); }
  .barra { justify-self: stretch; }
  .barra__track { display: flex; align-items: center; height: 2.25rem; }
  .barra__disc { flex: none; width: 0.5rem; height: 100%; background: var(--rojo); }
  .barra__bar { position: relative; flex: 1; height: 0.3rem; background: var(--carbon); }
  .barra__now {
    position: absolute;
    top: 50%;
    width: 0.3rem;
    height: 1.75rem;
    background: var(--blanco);
    transform: translate(-50%, -50%);
  }
  :global(.js) .barra__now { animation: slide 1200ms var(--ease-out) 300ms backwards; }
  @keyframes slide { from { left: 0; } }
  .barra__ends { display: flex; justify-content: space-between; margin-top: 0.4rem; color: var(--metal); font-size: var(--step-small); }
  .hours { display: grid; gap: 0.4rem; justify-self: stretch; margin: 0; }
  .hours div { display: flex; justify-content: space-between; gap: 1rem; }
  .hours dt { color: var(--metal); }
  .hours dd { margin: 0; font-weight: 500; }
  address { color: var(--metal); font-style: normal; }
  .horarios__map {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    background: var(--carbon);
    /* Dark map that matches the page; hue-rotate restores the pin colours after the invert. */
    filter: invert(0.9) hue-rotate(180deg) saturate(0.6);
  }

  @media (min-width: 60rem) {
    .horarios { grid-template-columns: 4fr 8fr; align-items: stretch; gap: 3rem; }
    .horarios__map { aspect-ratio: auto; min-height: 26rem; height: 100%; }
  }
</style>
