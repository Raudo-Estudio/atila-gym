---
import { HOURS, SITE } from '../../data/site';
import Button from '../Button.astro';
import Section from '../Section.astro';

const week = [
  { label: 'Lunes a viernes', hours: HOURS[1] },
  { label: 'Sábados', hours: HOURS[6] },
  { label: 'Domingos', hours: HOURS[0] },
];
const format = (time: string) => time.replace(/^0/, '').replace(':00', ' h');
---
<Section id="horarios" tone="rojo">
  <h2>Horarios y cómo llegar</h2>

  <div class="barra" data-barra>
    <p class="barra__status" data-barra-text>Mirá el horario de hoy en la tabla.</p>
    <div class="barra__track" aria-hidden="true">
      <span class="barra__disc"></span>
      <span class="barra__bar"><span class="barra__now" data-barra-now hidden></span></span>
      <span class="barra__disc"></span>
    </div>
    <div class="barra__ends" aria-hidden="true">
      <span data-barra-start>7 h</span>
      <span data-barra-end>23 h</span>
    </div>
  </div>

  <div class="split horarios">
    <div>
      <table>
        <caption class="visually-hidden">Horarios de Atila Gym</caption>
        <tbody>
          {week.map(({ label, hours }) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{hours.open && hours.close ? `${format(hours.open)} a ${format(hours.close)}` : 'Cerrado'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <address>
        {SITE.streetAddress}, {SITE.addressDetail}.<br />
        {SITE.locality}, Tigre.
      </address>
      <p>A 600 m de la Plaza General Pacheco.</p>
      <div class="horarios__cta"><Button href={SITE.directionsUrl} variant="quiet" external>Cómo llegar</Button></div>
    </div>
    <iframe
      class="horarios__map"
      src={SITE.mapEmbedUrl}
      title="Mapa de Atila Gym en General Pacheco"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</Section>

<script>
  import { getStatus } from '../../lib/hours';

  const status = getStatus(new Date());
  const hour = (time: string | null) => (time ? `${Number(time.split(':')[0])} h` : '');
  const text = document.querySelector('[data-barra-text]');
  const now = document.querySelector<HTMLElement>('[data-barra-now]');
  const start = document.querySelector('[data-barra-start]');
  const end = document.querySelector('[data-barra-end]');

  if (text) {
    text.textContent = status.open
      ? `Estamos abiertos hasta las ${status.closesAt}.`
      : `Ahora estamos cerrados. Abrimos el ${status.opensAt?.day} a las ${status.opensAt?.time}.`;
  }
  if (status.today.open) {
    if (start) start.textContent = hour(status.today.open);
    if (end) end.textContent = hour(status.today.close);
  }
  if (now && status.dayProgress !== null) {
    now.style.left = `${status.dayProgress * 100}%`;
    now.hidden = false;
  }
</script>

<style>
  .barra { margin-block: 3rem 4rem; }
  .barra__status { font-size: var(--step-lead); line-height: 1.3; margin-bottom: 1.5rem; }
  .barra__track { display: flex; align-items: center; height: clamp(4rem, 12vw, 9rem); }
  .barra__disc {
    flex: none;
    width: clamp(0.75rem, 2vw, 1.75rem);
    height: 100%;
    border-radius: var(--radius);
    background: var(--carbon);
  }
  .barra__bar { position: relative; flex: 1; height: clamp(0.5rem, 1.2vw, 0.9rem); background: var(--blanco); }
  .barra__now {
    position: absolute;
    top: 50%;
    width: 0.5rem;
    height: clamp(3rem, 9vw, 6.5rem);
    background: var(--carbon);
    transform: translate(-50%, -50%);
  }
  .barra__ends {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 700;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding-block: 0.6rem; border-bottom: 1px solid var(--blanco); text-align: left; font-weight: 400; }
  td { text-align: right; font-weight: 500; }
  address { font-style: normal; }
  .horarios__map {
    width: 100%;
    min-height: 22rem;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
    background: var(--plancha);
  }
</style>
