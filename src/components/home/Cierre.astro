---
import { SITE } from '../../data/site';
---
<section class="cierre">
  <p class="cierre__text" data-reveal>
    <span>Contanos qué querés entrenar y pasá cuando quieras. No hace falta reservar.</span>
  </p>
  <div class="ticket" data-reveal>
    <div class="ticket__inner">
      <h2>Vení a entrenar</h2>
      <p>Lunes a viernes de 7 a 23 h y sábados de 10 a 20 h.<br />{SITE.streetAddress}, {SITE.locality}.</p>
      <a class="ticket__action" href={SITE.whatsappUrl} target="_blank" rel="noopener">Escribinos por WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cierre {
    display: grid;
    gap: 3rem;
    padding: var(--section-space) var(--margin) 0;
    overflow: hidden;
    background: var(--carbon);
  }
  .cierre__text { font-size: var(--step-lead); line-height: 1.35; max-width: 28ch; }
  .ticket { justify-self: stretch; margin-bottom: var(--section-space); }
  .ticket__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    padding: 2.5rem 1.5rem;
    background: var(--rojo);
    color: var(--blanco);
    text-align: center;
  }
  .ticket h2 { font-size: var(--step-title); }
  .ticket p { max-width: 34ch; }
  .ticket__action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.5rem;
    background: var(--carbon);
    color: var(--blanco);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms, transform 160ms var(--ease-out);
  }
  .ticket__action:hover { background: var(--blanco); color: var(--carbon); }
  .ticket__action:active { transform: scale(0.98); }

  @media (min-width: 60rem) {
    .cierre { grid-template-columns: 4fr 1fr 7fr; align-items: end; }
    .cierre__text { grid-column: 1; margin-bottom: 4rem; }
    .ticket { grid-column: 3; width: 100%; max-width: 46rem; margin-bottom: var(--section-space); }
    .ticket__inner { align-content: center; padding: 3.5rem; }
  }
</style>
