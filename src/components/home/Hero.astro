---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import OpenStatus from '../OpenStatus.astro';
import Photo from '../Photo.astro';
---
<div class="hero">
  <div class="hero__copy">
    <h1 class="hero__title">
      <span class="hero__mask"><span class="hero__line">Atila Gym</span></span>
      <span class="visually-hidden">, gimnasio en General Pacheco</span>
    </h1>
    <p class="hero__lead">
      Gimnasio de musculación en General Pacheco. Cuatro pisos, máquinas por grupo muscular y profes en sala.
    </p>
    <div class="hero__actions">
      <Button href={SITE.whatsappUrl} variant="ink" external>Escribinos por WhatsApp</Button>
      <OpenStatus />
    </div>
  </div>
  <Photo
    class="hero__photo"
    src="/media/portada.webp"
    width={928}
    height={1152}
    alt="Sala de musculación con racks de mancuernas y bancos rojos"
    ratio="4 / 5"
    eager
  />
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding: 7rem var(--margin) var(--section-space);
    background: var(--rojo);
  }
  .hero__copy { display: grid; align-content: center; gap: 1.5rem; justify-items: start; }
  .hero__title { font-size: var(--step-display); letter-spacing: -0.02em; line-height: 0.9; }
  .hero__mask { display: block; overflow: hidden; padding-top: 0.04em; }
  .hero__line { display: block; }
  .hero__lead { max-width: 34ch; font-size: var(--step-lead); line-height: 1.35; }
  .hero__actions { display: grid; gap: 1rem; justify-items: start; }
  .hero__actions :global(.open-status) { color: var(--blanco); font-size: var(--step-small); }
  .hero :global(.hero__photo) { max-height: 70svh; background: rgb(0 0 0 / 0.18); }
  .hero :global(.photo--pending) { color: var(--blanco); }

  .js .hero__line { animation: rise 900ms var(--ease-out) backwards; }
  .js .hero__lead,
  .js .hero__actions { animation: fade 600ms ease-out 500ms backwards; }

  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } }

  @media (min-width: 60rem) {
    .hero { grid-template-columns: 7fr 5fr; align-items: center; gap: 4rem; min-height: 88svh; }
  }
</style>
