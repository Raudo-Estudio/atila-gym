---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import OpenStatus from '../OpenStatus.astro';
---
<div class="hero">
  <h1 class="hero__title">
    <span class="hero__place">Gimnasio en General Pacheco</span>
    <span class="hero__line">para entrenar</span>
    <span class="hero__line">
      <span class="hero__frame" aria-hidden="true">
        <svg viewBox="0 0 240 80" preserveAspectRatio="xMidYMid slice">
          <rect width="240" height="80" fill="var(--plancha)" />
          <rect x="16" y="37" width="208" height="6" fill="var(--metal)" />
          <rect x="44" y="10" width="14" height="60" fill="var(--rojo)" />
          <rect x="60" y="20" width="10" height="40" fill="var(--blanco)" />
          <rect x="182" y="10" width="14" height="60" fill="var(--rojo)" />
          <rect x="170" y="20" width="10" height="40" fill="var(--blanco)" />
        </svg>
      </span>
      en serio
    </span>
  </h1>
  <div class="hero__foot">
    <p class="hero__lead">Salones por grupo muscular, profes en sala y app de rutinas. Más de 10 años en Pacheco.</p>
    <div class="hero__actions">
      <span class="hero__cta"><Button href={SITE.whatsappUrl} external>Escribinos por WhatsApp</Button></span>
      <OpenStatus />
    </div>
  </div>
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: calc(100svh - 5.5rem);
    padding: clamp(2rem, 6vh, 5rem) var(--margin) 5.5rem;
  }
  .hero__title { font-size: var(--step-display); letter-spacing: -0.03em; }
  .hero__place {
    display: block;
    margin-bottom: 0.3em;
    font-size: clamp(1.5rem, 0.9rem + 3vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .hero__line { display: block; white-space: nowrap; }
  .hero__frame {
    display: inline-block;
    width: 1.75em;
    height: 0.72em;
    margin-right: 0.08em;
    overflow: hidden;
    border-radius: var(--radius);
    vertical-align: baseline;
    animation: shutter 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 150ms backwards;
  }
  .hero__frame svg { width: 100%; height: 100%; }
  .hero__foot { display: grid; gap: 2rem; }
  .hero__lead { font-size: var(--step-lead); line-height: 1.3; max-width: 34ch; }
  .hero__actions { display: grid; gap: 0.75rem; justify-items: start; }

  @keyframes shutter {
    from { clip-path: inset(0 50%); }
    to { clip-path: inset(0); }
  }

  .hero__cta { display: none; }

  @media (min-width: 48rem) {
    .hero { padding-bottom: 2.5rem; }
    .hero__cta { display: block; }
  }

  @media (min-width: 60rem) {
    .hero__foot { grid-template-columns: 1fr auto; align-items: end; }
    .hero__actions { justify-items: end; }
  }
</style>
