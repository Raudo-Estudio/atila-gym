---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import OpenStatus from '../OpenStatus.astro';
---
<div class="hero">
  <p class="hero__ghost" aria-hidden="true">Atila</p>

  <!-- Reemplazar por una foto real recortada del gym o del equipo. -->
  <svg class="hero__plate" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="198" fill="#0f1114" />
    <circle cx="200" cy="200" r="176" fill="#7d1016" />
    <circle cx="200" cy="200" r="118" fill="#0f1114" />
    <circle cx="200" cy="200" r="88" fill="#d2202a" />
    <circle cx="200" cy="200" r="34" fill="#0f1114" />
    <circle cx="200" cy="200" r="20" fill="#a9aeb6" />
  </svg>

  <div class="hero__copy">
    <h1 class="hero__title">
      <span class="hero__place">Gimnasio en General Pacheco</span>{' '}
      <span class="hero__line">para entrenar</span>{' '}
      <span class="hero__line">en serio</span>
    </h1>
    <p class="hero__lead">Salones por grupo muscular, profes en sala y app de rutinas.</p>
    <div class="hero__actions">
      <span class="hero__cta"><Button href={SITE.whatsappUrl} external>Escribinos por WhatsApp</Button></span>
      <OpenStatus />
    </div>
  </div>

  <ul class="hero__stats">
    <li class="stat stat--rojo">
      <strong>{SITE.rating.value}</strong>
      <span>en Google, sobre {SITE.rating.count} reseñas</span>
    </li>
    <li class="stat">
      <strong>+10</strong>
      <span>años acompañando a la comunidad de Pacheco</span>
    </li>
  </ul>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    gap: 2.5rem;
    min-height: min(100svh, 60rem);
    padding: 9rem var(--margin) 5.5rem;
    overflow: hidden;
    background: radial-gradient(70% 95% at 76% 42%, var(--rojo) 0%, var(--brasa) 42%, var(--carbon) 80%);
  }
  .hero__ghost {
    position: absolute;
    z-index: -2;
    top: 4.5rem;
    left: var(--margin);
    margin: 0;
    max-width: none;
    color: var(--carbon);
    opacity: 0.32;
    font-family: var(--font-display);
    font-size: clamp(9rem, 34vw, 34rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.8;
    text-transform: uppercase;
  }
  .hero__plate {
    position: absolute;
    z-index: -1;
    top: 8rem;
    right: -38%;
    width: 95vw;
    max-width: 44rem;
    opacity: 0.45;
    animation: roll 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
  }
  .hero__copy { display: grid; gap: 1.25rem; justify-items: start; }
  .hero__title { font-size: var(--step-display); letter-spacing: -0.03em; }
  .hero__place {
    display: block;
    margin-bottom: 0.4em;
    font-size: clamp(1.4rem, 0.9rem + 2.2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .hero__line { display: block; white-space: nowrap; }
  .hero__lead { font-size: var(--step-lead); line-height: 1.3; max-width: 30ch; }
  .hero__actions { display: grid; gap: 0.75rem; justify-items: start; }
  .hero__cta { display: none; }
  .hero__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .stat {
    display: grid;
    align-content: end;
    gap: 0.5rem;
    min-height: 10rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--carbon);
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .stat--rojo { background: var(--rojo); }
  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2rem + 3vw, 5.5rem);
    font-weight: 700;
    line-height: 0.9;
  }

  @keyframes roll {
    from { opacity: 0; transform: translateX(12%) rotate(40deg); }
  }

  @media (min-width: 48rem) {
    .hero { padding-bottom: 4rem; }
    .hero__cta { display: block; }
    .hero__stats { max-width: 30rem; }
  }

  @media (min-width: 60rem) {
    .hero__title { font-size: clamp(5rem, 0.5rem + 8.6vw, 10rem); }
    .hero__plate { top: auto; right: 7%; bottom: -14%; width: 46vw; opacity: 1; }
    .hero__stats { position: absolute; right: var(--margin); bottom: 3rem; width: 27rem; }
    .stat { min-height: 11rem; }
  }
</style>
