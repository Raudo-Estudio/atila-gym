---
import { SITE } from '../../data/site';
import Button from '../Button.astro';
import Logo from '../Logo.astro';
import OpenStatus from '../OpenStatus.astro';
import { withBase } from '../../lib/url';
---
<div class="intro" aria-hidden="true"><span class="intro__bar"></span></div>
<div class="hero" data-hero>
  <div class="hero__halo" aria-hidden="true"></div>
  <div class="hero__spot" aria-hidden="true"></div>

  <div class="hero__mark" aria-hidden="true">
    <Logo withName={false} class="hero__logo" />
  </div>

  <div class="hero__copy">
    <h1 class="hero__title">
      <span class="hero__mask"><span class="hero__line">Atila</span></span>
      <span class="hero__mask hero__l2"><span class="hero__line">Gym</span></span>
      <span class="visually-hidden">, gimnasio de musculación en General Pacheco</span>
    </h1>
    <div class="hero__foot">
      <div class="hero__where">
        <OpenStatus />
        <p>{SITE.streetAddress}, {SITE.locality}</p>
        <p class="hero__muted">Cuatro pisos, máquinas por grupo muscular y profes en sala</p>
      </div>
      <div class="hero__actions">
        <Button href={SITE.whatsappUrl} external>Escribinos por WhatsApp</Button>
        <Button href={withBase('/#salones')} variant="ghost">Ver los salones</Button>
      </div>
    </div>
  </div>
</div>

<script>
  // A soft red light follows the pointer and the logo leans toward it.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const fine = matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
  if (hero && fine) {
    let frame = 0;
    hero.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = hero.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width;
        const y = (event.clientY - box.top) / box.height;
        hero.style.setProperty('--mx', `${x * 100}%`);
        hero.style.setProperty('--my', `${y * 100}%`);
        hero.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
        hero.style.setProperty('--ry', `${(x - 0.5) * 18}deg`);
        hero.classList.add('is-lit');
      });
    });
    hero.addEventListener('pointerleave', () => {
      hero.classList.remove('is-lit');
      hero.style.setProperty('--rx', '0deg');
      hero.style.setProperty('--ry', '0deg');
    });
  }
</script>

<style>
  .hero {
    --mx: 70%;
    --my: 50%;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding: 6rem var(--margin) 5.5rem;
    overflow: hidden;
    isolation: isolate;
    /* Lit zones and dark zones instead of a flat field. */
    background:
      radial-gradient(60% 55% at 85% 100%, rgb(210 32 42 / 0.18), transparent 70%),
      radial-gradient(45% 45% at 0% 0%, rgb(210 32 42 / 0.1), transparent 70%),
      var(--carbon);
  }

  .hero__halo {
    position: absolute;
    left: 78%;
    top: 55%;
    z-index: -2;
    width: min(120vw, 1200px);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(closest-side, rgb(210 32 42 / 0.32), rgb(80 10 14 / 0.4) 45%, transparent);
  }
  .hero__spot {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(600px circle at var(--mx) var(--my), rgb(255 70 70 / 0.16), transparent 60%);
    transition: opacity 400ms;
  }
  .hero.is-lit .hero__spot { opacity: 1; }

  /* The mark as the hero's object, upright and whole, opposite the name. */
  .hero__mark {
    position: absolute;
    right: 50%;
    top: 32%;
    z-index: 0;
    width: 86vw;
    translate: 50% -50%;
    perspective: 1200px;
    pointer-events: none;
  }
  .hero :global(.hero__logo) {
    width: 100%;
    color: var(--rojo);
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.65)) drop-shadow(0 0 80px rgb(210 32 42 / 0.35));
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 600ms var(--ease-out);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .hero__title {
    display: grid;
    justify-items: start;
    font-size: clamp(4.5rem, 19vw, 13rem);
    letter-spacing: -0.02em;
    line-height: 0.82;
    /* Keeps the name readable where it crosses the red mark. */
    text-shadow: 0 10px 40px rgb(0 0 0 / 0.5);
  }
  .hero__mask { display: block; overflow: hidden; padding-top: 0.04em; }
  .hero__line { display: block; }

  .hero__foot { display: grid; gap: 1.5rem; justify-items: start; }
  .hero__where { display: grid; gap: 0.25rem; }
  .hero__where :global(.open-status) { color: var(--blanco); font-weight: 500; }
  .hero__muted { color: var(--metal); font-size: var(--step-small); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* Phone: the mark sits above the name. */
  @media (max-width: 59.99rem) {
    .hero__halo { top: 32%; }
  }

  /*
   * Opening, about 2 s: a red bar grows from the centre like the logo's barbell, the screen splits
   * open along it, then the logo is built piece by piece: bar, plates from the bar outward, the A.
   */
  .intro { display: none; }
  :global(.js) .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    pointer-events: none;
    animation: intro-gone 1ms linear 1.1s forwards;
  }
  .intro::before,
  .intro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: var(--carbon);
  }
  .intro::before { top: 0; animation: open-up 650ms cubic-bezier(0.7, 0, 0.2, 1) 450ms forwards; }
  .intro::after { bottom: 0; animation: open-down 650ms cubic-bezier(0.7, 0, 0.2, 1) 450ms forwards; }
  .intro__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    z-index: 1;
    height: 4px;
    translate: 0 -50%;
    background: var(--rojo);
    transform: scaleX(0);
    animation: grow-x 450ms var(--ease-out) forwards, fade-out 250ms ease-in 500ms forwards;
  }

  :global(.js) .hero__line { animation: rise 900ms var(--ease-out) 750ms backwards; }
  :global(.js) .hero__l2 .hero__line { animation-delay: 870ms; }
  :global(.js) .hero__foot { animation: fade 600ms ease-out 1.35s backwards; }
  :global(.js) .hero__halo { animation: fade-in 900ms ease-out 1.8s backwards; }

  .hero :global(.hero__logo .logo__bar),
  .hero :global(.hero__logo .logo__plate),
  .hero :global(.hero__logo .logo__a) { transform-box: fill-box; transform-origin: center; }
  :global(.js) .hero :global(.hero__logo .logo__bar) { animation: grow-x 450ms var(--ease-out) 0.9s backwards; }
  :global(.js) .hero :global(.hero__logo .logo__plate) {
    animation: plate-on 380ms cubic-bezier(0.3, 1.4, 0.5, 1) backwards;
    animation-delay: calc(1.25s + var(--i) * 100ms);
  }
  :global(.js) .hero :global(.hero__logo .logo__a) { animation: a-rise 600ms var(--ease-out) 1.6s backwards; }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .intro { display: none; }
  }

  @keyframes intro-gone { to { visibility: hidden; } }
  @keyframes open-up { to { transform: translateY(-100%); } }
  @keyframes open-down { to { transform: translateY(100%); } }
  @keyframes grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes fade-out { to { opacity: 0; } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes plate-on { from { transform: scale(0); } }
  @keyframes a-rise { from { clip-path: inset(100% 0 0 0); transform: translateY(12%); } to { clip-path: inset(0); } }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } }

  @media (min-width: 60rem) {
    .hero { align-items: center; padding-bottom: 4rem; }
    .hero__mark { right: calc(var(--margin) + 2vw); top: 52%; width: 40vw; translate: 0 -50%; }
    .hero__halo { left: 72%; top: 52%; }
    .hero__copy { justify-self: start; width: 52%; }
    .hero__title { font-size: clamp(6rem, 13vw, 15rem); }
  }
</style>
