---
const groups = [
  {
    id: 'entrenar',
    name: 'Para entrenar',
    items: ['Salón de pesos libres', 'Sala de máquinas por grupo muscular', 'Funcional, cardio, remo y ski', 'Profes en sala, sin reserva'],
  },
  {
    id: 'app',
    name: 'App Atila Coach',
    items: ['Rutina según tu objetivo', 'Ajuste cada 6 semanas', 'Bloques cortos para días con poco tiempo', 'Progreso y recetas'],
  },
  {
    id: 'lugar',
    name: 'El lugar',
    items: ['Vestuarios con duchas', 'Aire acondicionado y calefacción', 'Wi-Fi', 'Cafetería'],
  },
];
---
<section id="incluye" class="incluye" data-tabs>
  <h2>Qué incluye la cuota</h2>
  <div>
    <div class="tabs" role="tablist" aria-label="Qué incluye la cuota">
      {groups.map(({ id, name }) => (
        <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`}>{name}</button>
      ))}
    </div>
    {groups.map(({ id, name, items }) => (
      <div role="tabpanel" id={`panel-${id}`} aria-labelledby={`tab-${id}`}>
        <ul class="incluye__list" aria-label={name}>
          {items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .incluye { display: grid; gap: 2rem; padding: var(--section-space) var(--margin); background: var(--carbon); }
  .incluye__list {
    display: grid;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .incluye__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step-lead);
  }
  /* Red check square: what the cuota covers. */
  .incluye__list li::before {
    content: '';
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    background: var(--rojo);
  }
  @media (min-width: 60rem) {
    .incluye { grid-template-columns: 5fr 7fr; align-items: start; gap: 4rem; }
    .incluye__list { grid-template-columns: 1fr 1fr; column-gap: 2rem; }
  }
</style>
