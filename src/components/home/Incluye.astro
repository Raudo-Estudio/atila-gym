---
import Model3D from '../Model3D.astro';

const groups = [
  {
    name: 'Para entrenar',
    items: [
      { name: 'Salón de pesos libres', value: 'incluido' },
      { name: 'Sala de máquinas', value: 'incluida', note: 'Distribuida por grupo muscular.' },
      { name: 'Profes en sala', value: 'sin reserva', note: 'Preguntá lo que necesites mientras entrenás.' },
      { name: 'Funcional, cardio, remo y ski', value: 'incluidos' },
    ],
  },
  {
    name: 'App Atila Coach',
    items: [
      { name: 'Rutina personalizada', value: 'incluida', note: 'Según tu objetivo, ajustada cada 6 semanas según tu rendimiento.' },
      { name: 'Bloques cortos', value: 'en la app', note: 'Para los días con poco tiempo.' },
      { name: 'Recetas', value: 'en la app', note: 'Según tus preferencias.' },
      { name: 'Progreso en pesos y ejercicios', value: 'en la app' },
    ],
  },
  {
    name: 'El lugar',
    items: [
      { name: 'Vestuarios y duchas', value: 'incluidos' },
      { name: 'Aire acondicionado y calefacción', value: 'sí' },
      { name: 'Wi-Fi', value: 'sí' },
      { name: 'Cafetería', value: 'en el gym' },
    ],
  },
];
---
<section id="incluye" class="incluye">
  <div class="sheet" data-reveal>
    <h2>Qué incluye la cuota</h2>
    {groups.map(({ name, items }) => (
      <div class="sheet__group">
        <h3>{name}</h3>
        <dl>
          {items.map((item) => (
            <div class="sheet__row">
              <dt>{item.name}</dt>
              <dd>{item.value}</dd>
              {item.note && <dd class="sheet__note">{item.note}</dd>}
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
  <Model3D kind="plate" label="Disco de goma roja girando en 3D" class="incluye__model" />
</section>

<style>
  .incluye {
    display: grid;
    gap: 2rem;
    padding: var(--section-space) var(--margin);
    background: var(--rojo);
  }
  .sheet {
    display: grid;
    gap: 2.5rem;
    width: 100%;
    max-width: 40rem;
    padding: 2.5rem 1.5rem;
    background: var(--carbon);
  }
  .sheet h2 { font-size: var(--step-title); }
  .sheet h3 { margin-bottom: 0.5rem; color: var(--rojo); }
  dl { display: grid; margin: 0; }
  .sheet__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--plancha);
  }
  dt { font-weight: 500; }
  dd { margin: 0; color: var(--metal); text-align: right; }
  .sheet__note { grid-column: 1 / -1; max-width: 40ch; margin-top: 0.25rem; font-size: var(--step-small); text-align: left; }
  :global(.incluye__model) { height: 18rem; }

  @media (min-width: 60rem) {
    .incluye { grid-template-columns: 7fr 5fr; align-items: center; gap: 4rem; }
    .sheet { justify-self: end; padding: 3.5rem; }
    :global(.incluye__model) { height: 34rem; }
  }
</style>
