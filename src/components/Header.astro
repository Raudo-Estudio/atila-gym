---
import { NAV } from '../data/site';
import Logo from './Logo.astro';
---
<header class="header" data-header>
  <a class="header__brand" href="/"><Logo class="header__logo" /></a>
  <nav class="header__nav" aria-label="Principal">
    <ul>
      {NAV.map(({ href, label }) => (
        <li><a href={href} data-nav>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // Transparent over the hero, solid once the page moves under it.
  const update = () => header?.classList.toggle('is-solid', scrollY > 24);
  addEventListener('scroll', update, { passive: true });
  update();

  // The hero already shows the mark large, so the small one waits until it scrolls away.
  if (document.querySelector('[data-hero]')) header?.classList.add('has-hero');

  // Mark the link of the section on screen.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const byId = new Map(links.map((link) => [link.hash.slice(1), link]));
  const sections = [...byId.keys()].map((id) => document.getElementById(id)).filter((s) => s !== null);
  // The section crossing a line at 35% of the screen is the current one; between nav sections, none is.
  const markCurrent = () => {
    const line = innerHeight * 0.35;
    const current = sections.find((section) => {
      const box = section.getBoundingClientRect();
      return box.top <= line && box.bottom > line;
    });
    const active = current && byId.get(current.id);
    links.forEach((link) => (link === active ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current')));
  };
  // Three rects per scroll is cheap enough to run directly, with no frame of lag.
  addEventListener('scroll', markCurrent, { passive: true });
  markCurrent();
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem var(--margin);
    transition: background-color 250ms, padding 250ms;
  }
  .header.is-solid { background: var(--carbon); }
  .header__brand {
    display: block;
    color: var(--rojo);
    transition: opacity 300ms, visibility 300ms;
  }
  .header.has-hero:not(.is-solid) .header__brand { opacity: 0; visibility: hidden; }
  .header :global(.header__logo) { width: 3.5rem; }

  .header__nav { margin-left: auto; }
  .header__nav ul { display: flex; gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .header__nav a {
    display: inline-block;
    padding-block: 0.6rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    /* Same short red bar as the text links; it runs full width on the current section. */
    background: linear-gradient(var(--rojo), var(--rojo)) left bottom 0.3rem / 0 2px no-repeat;
    transition: background-size 300ms var(--ease-out), color 160ms;
  }
  .header__nav a:hover { background-size: 1.25rem 2px; }
  .header__nav a[aria-current] { background-size: 100% 2px; }

  @media (min-width: 48rem) {
    .header__nav ul { gap: 2.5rem; }
    .header :global(.header__logo) { width: 4rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .header__nav a,
    .header__brand { transition: none; }
  }
</style>
