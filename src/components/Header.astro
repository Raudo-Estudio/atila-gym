---
import { NAV } from '../data/site';
import Logo from './Logo.astro';
---
<header class="header" data-header>
  <a class="header__brand" href="/"><Logo class="header__logo" /></a>
  <nav class="header__nav" aria-label="Principal">
    <ul>
      {NAV.map(({ href, label }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Transparent over the red hero, solid once the page moves under it.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const update = () => header?.classList.toggle('is-solid', scrollY > 24);
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem var(--margin);
    transition: background-color 250ms, padding 250ms;
  }
  .header.is-solid { background: var(--carbon); }
  .header__brand { display: block; color: var(--blanco); }
  .header :global(.header__logo) { width: 4.25rem; transition: width 250ms var(--ease-out); }
  .header.is-solid :global(.header__logo) { width: 3.5rem; }
  .header.is-solid .header__brand { color: var(--rojo); }
  .header__nav ul { display: flex; gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .header__nav a { display: inline-block; padding-block: 0.5rem; font-weight: 500; text-decoration: none; }
  .header__nav a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
  @media (min-width: 48rem) {
    .header__nav ul { gap: 2rem; }
    .header :global(.header__logo) { width: 5rem; }
  }
</style>
