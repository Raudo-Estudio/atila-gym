---
import { NAV } from '../data/site';
---
<header class="header">
  <a class="header__brand" href="/">Atila Gym</a>
  <nav aria-label="Principal">
    <ul class="header__nav">
      {NAV.map(({ href, label }) => (
        <li><a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding: 1.25rem var(--margin);
  }
  .header__brand {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .header__nav {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .header__nav a { display: inline-block; padding-block: 0.5rem; text-decoration: none; }
  .header__nav a:hover, .header__nav a[aria-current] { text-decoration: underline; text-underline-offset: 0.3em; }
</style>
