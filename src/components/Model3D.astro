---
import type { ModelKind } from '../lib/gym3d';

interface Props {
  kind: ModelKind;
  label: string;
  class?: string;
}
const { kind, label, class: className } = Astro.props;
---
<div class:list={['model', className]} data-model={kind} role="img" aria-label={label}></div>

<script>
  import type { ModelKind } from '../lib/gym3d';

  const hosts = [...document.querySelectorAll<HTMLElement>('[data-model]:not([data-mounted])')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Load three.js only when a model gets near the screen.
  const loader = new IntersectionObserver((entries) => {
    entries.forEach(async ({ isIntersecting, target }) => {
      if (!isIntersecting) return;
      loader.unobserve(target);
      const host = target as HTMLElement;
      try {
        const { mountModel } = await import('../lib/gym3d');
        mountModel(host, host.dataset.model as ModelKind, reduced);
        host.dataset.mounted = '';
      } catch {
        // No WebGL: the section reads fine without the object.
        host.hidden = true;
      }
    });
  }, { rootMargin: '200px' });
  hosts.forEach((host) => loader.observe(host));
</script>

<style>
  .model :global(canvas) { display: block; width: 100%; height: 100%; }
  .js .model { animation: model-in 1200ms var(--ease-out) backwards; }
  @keyframes model-in { from { opacity: 0; transform: scale(0.92); } }
</style>
